#========================================================
# GERMANIUM PN JUNCTION DIODE
# SDEVICE : I-V CHARACTERISTICS + TEMPERATURE
#========================================================

File {

    Grid    = "@tdr@"
    Current = "@plot@"
    Plot    = "@tdrdat@"
    Output  = "@log@"
}

#========================================================
# ELECTRODES
#========================================================

Electrode {

    { Name = "Anode"   Voltage = 0.0 }
    { Name = "Cathode" Voltage = 0.0 }
}

#========================================================
# PHYSICS
#========================================================

Physics {

    Temperature = @temp@

    Mobility(
        DopingDependence
        HighFieldSaturation
    )

    EffectiveIntrinsicDensity(
        OldSlotboom
    )

    Recombination(
        SRH
    )
}

#========================================================
# PLOT
#========================================================

Plot {

    eDensity
    hDensity

    eCurrent
    hCurrent
    TotalCurrent

    eMobility
    hMobility

    ElectricField
    Potential
    SpaceCharge

    Doping
}

#========================================================
# INITIAL SOLUTION
#========================================================

Solve {

    Coupled(Iterations = 100) {
        Poisson
    }

    Coupled {
        Poisson
        Electron
        Hole
    }

#========================================================
# FORWARD I-V CHARACTERISTICS
#========================================================

    Quasistationary(
        InitialStep = 0.01
        Increment   = 1.3
        MinStep     = 1e-5
        MaxStep     = 0.02

        Goal {
            Name = "Anode"
            Voltage = 0.8
        }
    ) {

        Coupled {
            Poisson
            Electron
            Hole
        }
    }

#========================================================
# RETURN TO ZERO
#========================================================

    Quasistationary(
        InitialStep = 0.01
        Increment   = 1.3
        MinStep     = 1e-5
        MaxStep     = 0.02

        Goal {
            Name = "Anode"
            Voltage = 0.0
        }
    ) {

        Coupled {
            Poisson
            Electron
            Hole
        }
    }

#========================================================
# REVERSE I-V CHARACTERISTICS
#========================================================

    Quasistationary(
        InitialStep = 0.01
        Increment   = 1.3
        MinStep     = 1e-5
        MaxStep     = 0.05

        Goal {
            Name = "Anode"
            Voltage = -10.0
        }
    ) {

        Coupled {
            Poisson
            Electron
            Hole
        }
    }
}
